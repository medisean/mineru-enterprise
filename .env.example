# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="MinerU Enterprise"
DEBUG=false
# ⚠️  CRITICAL: Change this to a strong random key before deploying!
#     In production (DEBUG=false), the app will refuse to start with the default value.
#     Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret-key-in-production
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
# ⚠️  Set ALLOWED_HOSTS in production to prevent Host header injection.
#     Example: ALLOWED_HOSTS=["your-domain.com","api.your-domain.com"]
# ALLOWED_HOSTS=[]

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mineru

# ── S3 Storage ────────────────────────────────────────────────────────────────
# For MinIO (self-hosted):
S3_ENDPOINT_URL=http://minio:9000
# Browser-accessible MinIO endpoint for presigned URLs.
# In production with the bundled Nginx, prefer same-origin /minio.
# Example: S3_EXTERNAL_URL=http://your-domain/minio
# Leave empty in local direct-port setups if browser can reach S3_ENDPOINT_URL.
# S3_EXTERNAL_URL=
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION_NAME=us-east-1
S3_BUCKET_NAME=mineru-enterprise

# For AWS S3 (comment out S3_ENDPOINT_URL above):
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=your-aws-access-key
# S3_SECRET_ACCESS_KEY=your-aws-secret-key
# S3_REGION_NAME=ap-northeast-1

# For Alibaba OSS:
# S3_ENDPOINT_URL=https://oss-cn-hangzhou.aliyuncs.com
# S3_ACCESS_KEY_ID=your-oss-access-key
# S3_SECRET_ACCESS_KEY=your-oss-secret-key
# S3_REGION_NAME=cn-hangzhou

# ── MinerU Engine ─────────────────────────────────────────────────────────────
# empty = MinerU default (hybrid-auto-engine in v3); options: pipeline | hybrid-auto-engine | hybrid-http-client | vlm-auto-engine | vlm-http-client
MINERU_BACKEND=
MINERU_DEVICE=cpu
# MINERU_DEVICE=cuda                 # enable when GPU is available
# Production GPU worker: comma-separated GPU IDs, e.g. "0,1"; empty = all visible GPUs.
# GPU_WORKER_DEVICES=
# Production GPU worker model mounts. Required when running worker-gpu offline.
# MINERU_MODELS_HOST_PATH=./backend/mineru-models
# MINERU_CONFIG_HOST_PATH=./backend/mineru.json
# Local CPU worker concurrency. Default is 1 for local/dev.
# CPU_WORKER_CONCURRENCY=1

# ── MinerU Parse Defaults ────────────────────────────────────────────────────
# MINERU_DEFAULT_OCR=false           # true = force OCR, false = disable, null = auto-detect
# MINERU_DEFAULT_ENABLE_FORMULA=true
# MINERU_DEFAULT_ENABLE_TABLE=true
# MINERU_DEFAULT_PAGE_RANGES=        # e.g. "1-10" or "2,4-6"
# MAX_UPLOAD_SIZE_MB=50
# MAX_BATCH_FILES=100

# ── SSO ──────────────────────────────────────────────────────────────────────
# /login keeps local username/password login for admins.
# When enabled, ordinary users entering "/" are redirected to this provider.
SSO_AUTO_LOGIN_ENABLED=false
SSO_DEFAULT_PROVIDER=oauth2

# ── SSO — OIDC (Keycloak / Azure AD / Okta) ──────────────────────────────────
OIDC_ENABLED=false
OIDC_ISSUER=https://your-keycloak.example.com/realms/your-realm
OIDC_CLIENT_ID=mineru-enterprise
OIDC_CLIENT_SECRET=your-client-secret
OIDC_SCOPE="openid email profile"

# ── SSO — OAuth2 (Huawei IDaaS OAuth2) ───────────────────────────────────────
OAUTH2_ENABLED=false
OAUTH2_AUTHORIZATION_URL=https://your-idaas.example.com/oauth2/authorize
OAUTH2_TOKEN_URL=https://your-idaas.example.com/oauth2/token
OAUTH2_USERINFO_URL=https://your-idaas.example.com/oauth2/userinfo
OAUTH2_CLIENT_ID=mineru-enterprise
OAUTH2_CLIENT_SECRET=your-client-secret
OAUTH2_SCOPE="openid email profile"
OAUTH2_TOKEN_AUTH_METHOD=client_secret_post
OAUTH2_USER_ID_FIELD=sub
OAUTH2_EMAIL_FIELD=email
OAUTH2_NAME_FIELD=name
OAUTH2_AVATAR_FIELD=picture

# ── SSO — LDAP ────────────────────────────────────────────────────────────────
LDAP_ENABLED=false
LDAP_SERVER=ldap://your-ldap-server:389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your-ldap-password
LDAP_BASE_DN=dc=example,dc=com

# ── SSO — WeChat Work (企业微信) ──────────────────────────────────────────────
WECHAT_WORK_ENABLED=false
WECHAT_WORK_CORP_ID=your-corp-id
WECHAT_WORK_AGENT_ID=your-agent-id
WECHAT_WORK_SECRET=your-secret

# ── SSO — DingTalk (钉钉) ─────────────────────────────────────────────────────
DINGTALK_ENABLED=false
DINGTALK_APP_KEY=your-app-key
DINGTALK_APP_SECRET=your-app-secret

# ── Frontend env ──────────────────────────────────────────────────────────────
# Runtime-injected into the web container. Leave empty in production when Nginx
# serves web and /api from the same domain.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=MinerU Enterprise
NEXT_PUBLIC_OIDC_ENABLED=false
NEXT_PUBLIC_OAUTH2_ENABLED=false
NEXT_PUBLIC_WECHAT_WORK_ENABLED=false
NEXT_PUBLIC_DINGTALK_ENABLED=false

# ── Docker image build/publish ───────────────────────────────────────────────
IMAGE_REPOSITORY=mineru-enterprise
IMAGE_TAG=latest
# PLATFORM=linux/amd64
# PUSH=false
# API_BASE_IMAGE=ubuntu:22.04
# PYTHON_BASE_IMAGE=python:3.11-slim
# NODE_BASE_IMAGE=node:20-alpine
# CUDA_BASE_IMAGE=nvidia/cuda:12.4.1-runtime-ubuntu22.04
# NGINX_BASE_IMAGE=nginx:1.27-alpine
# APT_MIRROR=                         # Backward-compatible apt mirror fallback
# API_UBUNTU_APT_MIRROR=              # API Ubuntu image, e.g. https://mirrors.aliyun.com/ubuntu
# DEBIAN_APT_MIRROR=                  # CPU worker, e.g. https://mirrors.aliyun.com/debian
# UBUNTU_APT_MIRROR=                  # GPU worker CUDA image, e.g. https://mirrors.aliyun.com/ubuntu
# ALPINE_MIRROR=
# PIP_INDEX_URL=
# PIP_EXTRA_INDEX_URL=
# PYTORCH_INDEX_URL=                  # Optional; empty = install torch from PIP_INDEX_URL/default pip index
# NPM_REGISTRY=
# TORCH_VERSION=2.7.0
# CUDA_VERSION=cu124
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# ── MinIO (if using local MinIO profile) ─────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
