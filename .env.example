# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="MinerU Enterprise"
DEBUG=false
SECRET_KEY=change-me-to-a-random-secret-key-in-production
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mineru

# ── S3 Storage ────────────────────────────────────────────────────────────────
# For MinIO (self-hosted):
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION_NAME=us-east-1
S3_BUCKET_NAME=mineru-enterprise

# For AWS S3 (comment out S3_ENDPOINT_URL above):
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=your-aws-access-key
# S3_SECRET_ACCESS_KEY=your-aws-secret-key
# S3_REGION_NAME=ap-northeast-1

# For Alibaba OSS:
# S3_ENDPOINT_URL=https://oss-cn-hangzhou.aliyuncs.com
# S3_ACCESS_KEY_ID=your-oss-access-key
# S3_SECRET_ACCESS_KEY=your-oss-secret-key
# S3_REGION_NAME=cn-hangzhou

# ── MinerU Engine ─────────────────────────────────────────────────────────────
# empty = MinerU default (hybrid-auto-engine in v3); options: pipeline | hybrid-auto-engine | hybrid-http-client | vlm-auto-engine | vlm-http-client
MINERU_BACKEND=
MINERU_DEVICE=cpu
# MINERU_DEVICE=cuda                 # enable when GPU is available

# ── MinerU Parse Defaults ────────────────────────────────────────────────────
# MINERU_DEFAULT_OCR=false           # true = force OCR, false = disable, null = auto-detect
# MINERU_DEFAULT_ENABLE_FORMULA=true
# MINERU_DEFAULT_ENABLE_TABLE=true
# MINERU_DEFAULT_PAGE_RANGES=        # e.g. "1-10" or "2,4-6"

# ── SSO — OIDC (Keycloak / Azure AD / Okta) ──────────────────────────────────
OIDC_ENABLED=false
OIDC_ISSUER=https://your-keycloak.example.com/realms/your-realm
OIDC_CLIENT_ID=mineru-enterprise
OIDC_CLIENT_SECRET=your-client-secret

# ── SSO — LDAP ────────────────────────────────────────────────────────────────
LDAP_ENABLED=false
LDAP_SERVER=ldap://your-ldap-server:389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your-ldap-password
LDAP_BASE_DN=dc=example,dc=com

# ── SSO — WeChat Work (企业微信) ──────────────────────────────────────────────
WECHAT_WORK_ENABLED=false
WECHAT_WORK_CORP_ID=your-corp-id
WECHAT_WORK_AGENT_ID=your-agent-id
WECHAT_WORK_SECRET=your-secret

# ── SSO — DingTalk (钉钉) ─────────────────────────────────────────────────────
DINGTALK_ENABLED=false
DINGTALK_APP_KEY=your-app-key
DINGTALK_APP_SECRET=your-app-secret

# ── Frontend env ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=MinerU Enterprise
NEXT_PUBLIC_OIDC_ENABLED=false
NEXT_PUBLIC_WECHAT_WORK_ENABLED=false
NEXT_PUBLIC_DINGTALK_ENABLED=false

# ── Docker image build/publish ───────────────────────────────────────────────
IMAGE_REPOSITORY=mineru-enterprise
IMAGE_TAG=latest
# PLATFORM=linux/amd64
# PUSH=false
# PYTHON_BASE_IMAGE=python:3.11-slim
# NODE_BASE_IMAGE=node:20-alpine
# CUDA_BASE_IMAGE=nvidia/cuda:12.4.1-runtime-ubuntu22.04
# NGINX_BASE_IMAGE=nginx:1.27-alpine
# APT_MIRROR=
# ALPINE_MIRROR=
# PIP_INDEX_URL=
# PIP_EXTRA_INDEX_URL=
# PYTORCH_INDEX_URL=
# NPM_REGISTRY=
# TORCH_VERSION=2.7.0
# CUDA_VERSION=cu124
# HF_ENDPOINT=https://hf-mirror.com
# REQUIRE_MINERU_MODELS=true
# MINERU_MODEL_DOWNLOAD_SOURCE=huggingface
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# ── MinIO (if using local MinIO profile) ─────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
