# MinerU worker image — includes full MinerU model dependencies + LibreOffice for Office->PDF preview
ARG PYTHON_BASE_IMAGE=python:3.11-slim
FROM ${PYTHON_BASE_IMAGE}

WORKDIR /app

ARG APT_MIRROR=
ARG DEBIAN_APT_MIRROR=
ARG PIP_INDEX_URL=
ARG PIP_EXTRA_INDEX_URL=
ARG PYTORCH_INDEX_URL=

# System deps: build tools + runtime libs + LibreOffice + CJK fonts
RUN mirror="${DEBIAN_APT_MIRROR:-$APT_MIRROR}"; \
    if [ -n "$mirror" ]; then \
        if [ -f /etc/apt/sources.list.d/debian.sources ]; then sed -i "s|http://deb.debian.org/debian|${mirror}|g; s|http://security.debian.org/debian-security|${mirror}-security|g" /etc/apt/sources.list.d/debian.sources; fi; \
        if [ -f /etc/apt/sources.list ]; then sed -i "s|http://deb.debian.org/debian|${mirror}|g; s|http://security.debian.org/debian-security|${mirror}-security|g" /etc/apt/sources.list; fi; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ cmake libmagic1 libgl1 libglib2.0-0 \
    libldap2-dev libsasl2-dev \
    poppler-utils \
    curl wget \
    libreoffice-writer-nogui libreoffice-impress-nogui libreoffice-calc-nogui \
    libreoffice-java-common default-jre-headless \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# ── Install PyTorch CPU-only first (large layer, cache-friendly) ────────
# On aarch64 (ARM64) the default PyPI wheel is already CPU-only.
# Pin a known-good version to avoid surprise breakage.
ARG TORCH_VERSION=2.7.0
RUN if [ -n "$PIP_INDEX_URL" ]; then python -m pip config set global.index-url "$PIP_INDEX_URL"; fi \
    && if [ -n "$PIP_EXTRA_INDEX_URL" ]; then python -m pip config set global.extra-index-url "$PIP_EXTRA_INDEX_URL"; fi \
    && if [ -n "$PYTORCH_INDEX_URL" ]; then \
        python -m pip install --no-cache-dir torch==${TORCH_VERSION} torchvision --extra-index-url "$PYTORCH_INDEX_URL"; \
    else \
        python -m pip install --no-cache-dir torch==${TORCH_VERSION} torchvision; \
    fi

# ── Install MinerU with [pipeline] extra (includes transformers, albumentations etc.) ──
COPY requirements.txt requirements-worker.txt ./
RUN python -m pip install --no-cache-dir -r requirements-worker.txt

# ── Local model cache paths ──────────────────────────────────────────────────
# Local CPU worker may download/cache models here. Offline mineru.json is only
# required by the GPU/production worker image.
ENV HF_HOME=/opt/mineru-models/huggingface \
    HUGGINGFACE_HUB_CACHE=/opt/mineru-models/huggingface/hub \
    TRANSFORMERS_CACHE=/opt/mineru-models/huggingface/hub

COPY . .

CMD ["celery", "-A", "app.workers.parse_worker.celery_app", "worker", "-Q", "parse_cpu", "-c", "1", "--loglevel=info"]
