# MinerU worker image — includes full MinerU model dependencies + LibreOffice for Office->PDF preview
ARG PYTHON_BASE_IMAGE=python:3.11-slim
FROM ${PYTHON_BASE_IMAGE}

WORKDIR /app

ARG APT_MIRROR=
ARG PIP_INDEX_URL=
ARG PIP_EXTRA_INDEX_URL=
ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# System deps: build tools + runtime libs + LibreOffice + CJK fonts
RUN if [ -n "$APT_MIRROR" ]; then \
        if [ -f /etc/apt/sources.list.d/debian.sources ]; then sed -i "s|http://deb.debian.org/debian|${APT_MIRROR}|g; s|http://security.debian.org/debian-security|${APT_MIRROR}-security|g" /etc/apt/sources.list.d/debian.sources; fi; \
        if [ -f /etc/apt/sources.list ]; then sed -i "s|http://deb.debian.org/debian|${APT_MIRROR}|g; s|http://security.debian.org/debian-security|${APT_MIRROR}-security|g" /etc/apt/sources.list; fi; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ cmake libmagic1 libgl1 libglib2.0-0 \
    libldap2-dev libsasl2-dev \
    poppler-utils \
    curl wget \
    libreoffice-writer-nogui libreoffice-impress-nogui libreoffice-calc-nogui \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# ── Install PyTorch CPU-only first (large layer, cache-friendly) ────────
# On aarch64 (ARM64) the default PyPI wheel is already CPU-only.
# Pin a known-good version to avoid surprise breakage.
ARG TORCH_VERSION=2.7.0
RUN if [ -n "$PIP_INDEX_URL" ]; then python -m pip config set global.index-url "$PIP_INDEX_URL"; fi \
    && if [ -n "$PIP_EXTRA_INDEX_URL" ]; then python -m pip config set global.extra-index-url "$PIP_EXTRA_INDEX_URL"; fi \
    && python -m pip install --no-cache-dir \
    torch==${TORCH_VERSION} \
    torchvision \
    --extra-index-url ${PYTORCH_INDEX_URL} || \
    python -m pip install --no-cache-dir \
    torch==${TORCH_VERSION} \
    torchvision

# ── Install MinerU with [pipeline] extra (includes transformers, albumentations etc.) ──
COPY requirements.txt requirements-worker.txt ./
RUN python -m pip install --no-cache-dir -r requirements-worker.txt

# ── Pre-download all MinerU models during build ──────────────────────────────
# Use HF_ENDPOINT=hf-mirror.com for faster downloads in China.
# Downloads both pipeline models (PDF-Extract-Kit) and VLM models (MinerU2.5-Pro)
# so production can run in offline environments.
ARG HF_ENDPOINT=https://hf-mirror.com
ARG REQUIRE_MINERU_MODELS=true
ARG MINERU_MODEL_DOWNLOAD_SOURCE=huggingface
ENV HF_HOME=/opt/mineru-models/huggingface \
    HUGGINGFACE_HUB_CACHE=/opt/mineru-models/huggingface/hub \
    TRANSFORMERS_CACHE=/opt/mineru-models/huggingface/hub \
    MINERU_TOOLS_CONFIG_JSON=/opt/mineru-models/mineru.json \
    MINERU_MODEL_SOURCE=local \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

# Use MinerU's official downloader so it also writes models-dir to mineru.json.
RUN mkdir -p /opt/mineru-models \
    && HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 MINERU_MODEL_SOURCE="${MINERU_MODEL_DOWNLOAD_SOURCE}" \
       mineru-models-download --source "${MINERU_MODEL_DOWNLOAD_SOURCE}" --model_type all \
    || if [ "$REQUIRE_MINERU_MODELS" = "true" ]; then exit 1; else echo "WARN: MinerU model pre-download failed"; fi

COPY . .

CMD ["celery", "-A", "app.workers.parse_worker.celery_app", "worker", "-Q", "parse_cpu", "-c", "2", "--loglevel=info"]
