# MinerU worker image — includes full MinerU model dependencies + LibreOffice for Office→PDF preview
FROM python:3.11-slim

WORKDIR /app

# System deps: build tools + runtime libs + LibreOffice + CJK fonts
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ cmake libmagic1 libgl1 libglib2.0-0 \
    libldap2-dev libsasl2-dev \
    poppler-utils \
    curl wget \
    libreoffice-writer-nogui libreoffice-impress-nogui libreoffice-calc-nogui \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# ── Install PyTorch CPU-only first (large layer, cache-friendly) ────────
# On aarch64 (ARM64) the default PyPI wheel is already CPU-only.
# Pin a known-good version to avoid surprise breakage.
ARG TORCH_VERSION=2.7.0
RUN pip install --no-cache-dir \
    torch==${TORCH_VERSION} \
    torchvision \
    --index-url https://download.pytorch.org/whl/cpu || \
    pip install --no-cache-dir \
    torch==${TORCH_VERSION} \
    torchvision

# ── Install MinerU with [pipeline] extra (includes transformers, albumentations etc.) ──
COPY requirements.txt requirements-worker.txt ./
RUN pip install --no-cache-dir -r requirements-worker.txt

# Pre-download MinerU pipeline models during build.
# First run otherwise takes 3-5 min to download from HuggingFace/ModelScope.
# Models are cached in ~/.cache/huggingface/hub/
RUN python -c "\
import os; \
os.environ['MINERU_DEVICE']='cpu'; \
from mineru.backend.pipeline.model_init import MineruPipelineModel; \
model = MineruPipelineModel(device='cpu', lang='ch'); \
print('MinerU pipeline models pre-downloaded OK')" \
|| echo "WARN: model pre-download failed, will download on first run"

COPY . .

CMD ["celery", "-A", "app.workers.parse_worker.celery_app", "worker", "-Q", "parse", "-c", "2", "--loglevel=info"]
