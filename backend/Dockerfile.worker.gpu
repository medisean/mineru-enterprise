# MinerU GPU worker image — CUDA + MinerU model dependencies + LibreOffice for Office->PDF preview
# Requires: nvidia-container-toolkit on the host
# Usage:    docker compose --profile gpu up -d

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

# Prevent interactive prompts during apt install
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# System deps: build tools + runtime libs + LibreOffice + CJK fonts
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ cmake libmagic1 libgl1 libglib2.0-0 \
    libldap2-dev libsasl2-dev \
    poppler-utils \
    curl wget \
    libreoffice-writer-nogui libreoffice-impress-nogui libreoffice-calc-nogui \
    fonts-noto-cjk \
    python3.11 python3.11-venv python3.11-dev python3-pip \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# ── Install PyTorch with CUDA support ────────────────────────────────────
ARG TORCH_VERSION=2.7.0
ARG CUDA_VERSION=cu124
RUN python3 -m pip install --no-cache-dir --break-system-packages \
    torch==${TORCH_VERSION} \
    torchvision \
    --index-url https://download.pytorch.org/whl/${CUDA_VERSION}

# ── Install MinerU with [pipeline] extra (includes transformers, albumentations etc.) ──
COPY requirements.txt requirements-worker.txt ./
RUN python3 -m pip install --no-cache-dir --break-system-packages -r requirements-worker.txt

# ── Pre-download all MinerU models during build ──────────────────────────────
# Use HF_ENDPOINT=hf-mirror.com for faster downloads in China.
ARG HF_ENDPOINT=https://hf-mirror.com

# 1) Pipeline models (used by --backend pipeline and hybrid backends)
#    MineruPipelineModel init needs formula_config, so we use snapshot_download directly.
RUN python3 -c "\
import os; \
os.environ['MINERU_DEVICE']='cpu'; \
from huggingface_hub import snapshot_download; \
path = snapshot_download('opendatalab/PDF-Extract-Kit-1.0', max_workers=2); \
print(f'Pipeline model pre-downloaded to: {path}')" \
|| echo "WARN: pipeline model pre-download failed, will download on first run"

# 2) VLM models (used by --backend hybrid-auto-engine / vlm-auto-engine)
RUN python3 -c "\
import os; \
os.environ['MINERU_DEVICE']='cpu'; \
from huggingface_hub import snapshot_download; \
path = snapshot_download('opendatalab/MinerU2.5-Pro-2604-1.2B', max_workers=2); \
print(f'VLM model pre-downloaded to: {path}')" \
|| echo "WARN: VLM model pre-download failed, will download on first run"

COPY . .

CMD ["celery", "-A", "app.workers.parse_worker.celery_app", "worker", "-Q", "parse_gpu", "-c", "2", "--loglevel=info"]
