# MinerU GPU worker image — CUDA + MinerU model dependencies + LibreOffice for Office->PDF preview
# Requires: nvidia-container-toolkit on the host
# Usage:    docker compose --profile gpu up -d

ARG CUDA_BASE_IMAGE=nvidia/cuda:12.4.1-runtime-ubuntu22.04
FROM ${CUDA_BASE_IMAGE}

# Prevent interactive prompts during apt install
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

ARG APT_MIRROR=
ARG UBUNTU_APT_MIRROR=
ARG PIP_INDEX_URL=
ARG PIP_EXTRA_INDEX_URL=

# System deps: build tools + runtime libs + LibreOffice + CJK fonts
RUN mirror="${UBUNTU_APT_MIRROR:-$APT_MIRROR}"; \
    if [ -n "$mirror" ]; then \
        if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then sed -i "s|http://archive.ubuntu.com/ubuntu|${mirror}|g; s|http://security.ubuntu.com/ubuntu|${mirror}|g" /etc/apt/sources.list.d/ubuntu.sources; fi; \
        if [ -f /etc/apt/sources.list ]; then sed -i "s|http://archive.ubuntu.com/ubuntu|${mirror}|g; s|http://security.ubuntu.com/ubuntu|${mirror}|g" /etc/apt/sources.list; fi; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ cmake libmagic1 libgl1 libglib2.0-0 \
    libldap2-dev libsasl2-dev \
    poppler-utils \
    curl wget \
    libreoffice-writer-nogui libreoffice-impress-nogui libreoffice-calc-nogui \
    fonts-noto-cjk \
    python3.11 python3.11-venv python3.11-dev python3-pip \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# ── Install PyTorch with CUDA support ────────────────────────────────────
ARG TORCH_VERSION=2.7.0
ARG CUDA_VERSION=cu124
ARG PYTORCH_INDEX_URL=
RUN python3 -m pip install --upgrade pip setuptools wheel
RUN if [ -n "$PIP_INDEX_URL" ]; then python3 -m pip config set global.index-url "$PIP_INDEX_URL"; fi \
    && if [ -n "$PIP_EXTRA_INDEX_URL" ]; then python3 -m pip config set global.extra-index-url "$PIP_EXTRA_INDEX_URL"; fi \
    && python3 -m pip install --upgrade --break-system-packages pip setuptools wheel \
    && if [ -n "$PYTORCH_INDEX_URL" ]; then \
        python3 -m pip install --no-cache-dir --break-system-packages torch==${TORCH_VERSION} torchvision --extra-index-url "$PYTORCH_INDEX_URL"; \
    else \
        python3 -m pip install --no-cache-dir --break-system-packages torch==${TORCH_VERSION} torchvision; \
    fi

# ── Install MinerU with [pipeline] extra (includes transformers, albumentations etc.) ──
COPY requirements.txt requirements-worker.txt ./
RUN python3 -m pip install --no-cache-dir --break-system-packages -r requirements-worker.txt

# ── Runtime-mounted MinerU model paths ───────────────────────────────────────
ENV HF_HOME=/opt/mineru-models/huggingface \
    HUGGINGFACE_HUB_CACHE=/opt/mineru-models/huggingface/hub \
    TRANSFORMERS_CACHE=/opt/mineru-models/huggingface/hub \
    MINERU_MODEL_SOURCE=local \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

COPY . .
RUN chmod +x /app/scripts/start-gpu-worker.sh

CMD ["/app/scripts/start-gpu-worker.sh"]
